# AvexJets — one charter request, end to end, in one continuous take.
#
# Customer asks → ops reviews and sources → operator quotes → ops builds and
# sends the quote → customer accepts → reserve, invoice, payment, manifest,
# operator confirmed → the customer sees a confirmed trip.
#
# Every click, form and validation here is the real product. Only the backend
# is canned: the store is not connected locally, so the API responses come from
# demos/avex/fixtures (regenerate with `node demos/avex/fixtures.mjs`). The
# proof log names every stubbed endpoint — this take never passes as live.
#
# Run the app first:
#   cd ~/avax && set -a && . ./.env.local && set +a && vercel dev --listen 3200
# Sign-in details live in Retake's .env as AVEX_OPS_USERNAME / AVEX_OPS_PASSWORD.

name: avex-full-flow
title: "AvexJets — one request, from ask to confirmed"
url: http://localhost:3200
preset: post-landscape
viewport: { width: 1600, height: 1000 }
scale: 1                       # >1 currently breaks focus clicks on these forms
reducedMotion: true
camera: static
layout: none
captions: false

# The ops role reaches /operator too, so one session drives all three portals.
# These sign-in steps are skipped once a session is saved; `setup` still runs.
auth:
  storageState: .auth/avex.json
  maxAgeHours: 8
  setup:
    - { action: navigate, url: "http://localhost:3200/sign-in?next=/operations" }
    - { action: fill, selector: "#user", text: "${AVEX_OPS_USERNAME}" }
    - { action: fill, selector: "#password", text: "${AVEX_OPS_PASSWORD}", secret: true }
    - { action: click, selector: "button[data-t='go']" }
    # prove the session took, rather than assuming it and failing 20 steps later
    - { action: waitFor, selector: "a[href='/api/sign-out']", timeout: 15000 }
    - { action: wait, ms: 1200 }

setup:
  - { action: navigate, url: "http://localhost:3200/#/request" }
  - { action: wait, ms: 1500 }

stub:
  - { url: "**/api/requests", method: POST, from: avex/fixtures/submit.json }
  - { url: "**/api/requests*", method: GET, from: avex/fixtures/requests-empty.json }
  - { url: "**/api/operator-desk*", from: avex/fixtures/desk-open.json }
  - { url: "**/api/ops", from: avex/fixtures/ops-new.json }
  - { url: "**/api/track", from: avex/fixtures/track-arranging.json }
  - { url: "**/api/notes*", json: { ok: true, you: "control", notes: [] } }

steps:
  # ── 1. the customer asks ────────────────────────────────────────────────
  - { action: scene, label: ask, caption: "A customer asks for a jet." }
  - { action: waitFor, selector: "#f-name" }
  - { action: wait, ms: 1200 }
  - { action: scroll, to: "#f-name", align: center, pauseAfter: 600 }
  - { action: type, selector: "#f-name", text: "Nguyen Minh Anh", delay: 40 }
  - { action: fill, selector: "#f-email", text: "minh.anh@example.com" }
  - { action: fill, selector: "#f-phone", text: "+84 90 123 4567", pauseAfter: 700 }
  - { action: click, selector: "button[data-act='next']", pauseAfter: 1200 }

  # trip: the from/to fields are airport autocompletes
  - { action: waitFor, selector: "#leg-from-0" }
  - { action: scroll, to: "#leg-from-0", align: center, pauseAfter: 500 }
  # the airport fields are autocompletes: type, then pick the airport
  - { action: type, selector: "#leg-from-0", text: "SGN", delay: 110, pauseAfter: 700 }
  - { action: click, selector: "button[data-pick='SGN']", pauseAfter: 600 }
  - { action: type, selector: "#leg-to-0", text: "SIN", delay: 110, pauseAfter: 700 }
  - { action: click, selector: "button[data-pick='SIN']", pauseAfter: 600 }   # Changi, not Seletar
  - { action: fill, selector: "#leg-date-0", text: "2026-10-02" }
  - { action: fill, selector: "#f-pax", text: "4", pauseAfter: 800 }
  - { action: click, selector: "button[data-act='next']", pauseAfter: 1200 }

  # planning: leave it alone, it is all optional
  - { action: scene, label: planning, caption: "Preferences, all optional." }
  - { action: wait, ms: 1500 }
  - { action: click, selector: "button[data-act='next']", pauseAfter: 1200 }

  # confirm
  - { action: scene, label: confirm, caption: "One read-back, then send." }
  - { action: scroll, to: "[data-field='human']", align: center, pauseAfter: 600 }
  - { action: click, selector: "[data-field='human']", pauseAfter: 900 }
  - { action: click, selector: "button[data-act='submit']" }
  - { action: waitFor, selector: ".pill-ok", timeout: 20000 }
  - { action: scene, label: sent, caption: "Received, with a reference." }
  - { action: wait, ms: 2600 }

  # ── 2. it lands in operations ───────────────────────────────────────────
  - { action: stub, url: "**/api/requests*", method: GET, from: avex/fixtures/requests-new.json }
  - { action: navigate, url: "http://localhost:3200/operations#/" }
  - { action: waitFor, selector: ".strip", timeout: 20000 }
  - { action: scene, label: queue, caption: "It is in the operations queue." }
  - { action: wait, ms: 2600 }
  - { action: click, selector: "a.btn-primary[href^='#/live/']", pauseAfter: 1800 }

  # review
  - { action: scene, label: review, caption: "Someone owns it, and says why it is workable." }
  - { action: scroll, to: "[data-ops-field='review_notes']", align: center, pauseAfter: 600 }
  - { action: type, selector: "[data-ops-field='review_notes']", text: "Straightforward SGN-SIN evening sector. Midsize is right for four with golf bags.", delay: 16, pauseAfter: 700 }
  - { action: stub, url: "**/api/ops", from: avex/fixtures/ops-reviewed.json }
  - { action: click, selector: "[data-act='ops-review']", pauseAfter: 2200 }

  # sourcing
  - { action: scene, label: sourcing, caption: "Sourcing opens: what to look for, and by when." }
  - { action: fill, selector: "[data-ops-field='route_constraints']", text: "Seletar night curfew 22:00-07:00. Slots at SGN three days ahead.", pauseAfter: 900 }
  - { action: stub, url: "**/api/ops", from: avex/fixtures/ops-sourcing.json }
  - { action: click, selector: "[data-act='ops-source']", pauseAfter: 2400 }

  # ── 3. the operator quotes ──────────────────────────────────────────────
  - { action: navigate, url: "http://localhost:3200/operator#/" }
  - { action: waitFor, selector: "[data-op-scope]", timeout: 20000 }
  - { action: scene, label: operator, caption: "The operator sees it, open for offers." }
  - { action: wait, ms: 2400 }
  - { action: scroll, to: "[data-op-field='aircraft']", align: center, pauseAfter: 600 }
  - { action: fill, selector: "[data-op-field='aircraft']", text: "Embraer Legacy 600" }
  - { action: type, selector: "[data-op-field='price']", text: "17400", delay: 90 }
  - { action: fill, selector: "[data-op-field='terms']", text: "Crew, handling, landing and parking included.", pauseAfter: 900 }
  - { action: stub, url: "**/api/operator-desk*", method: POST, from: avex/fixtures/offer-sent.json }
  - { action: stub, url: "**/api/operator-desk*", from: avex/fixtures/desk-quoted.json }
  - { action: scene, label: offer, caption: "An offer goes back: aircraft, price, what it includes." }
  - { action: click, selector: "[data-act='op-offer']", pauseAfter: 2600 }

  # ── 4. ops turns the offer into a quote ─────────────────────────────────
  - { action: stub, url: "**/api/requests*", method: GET, from: avex/fixtures/requests-offer.json }
  - { action: navigate, url: "http://localhost:3200/operations#/live/AVX-0912-4821" }
  - { action: waitFor, selector: "[data-ops-scope]", timeout: 20000 }
  - { action: scene, label: quote, caption: "Ops builds the customer quote on top of the cost." }
  - { action: scroll, to: "[data-ops-field='item1_amount']", align: center, pauseAfter: 600 }
  - { action: fill, selector: "[data-ops-field='item1_amount']", text: "19000" }
  - { action: fill, selector: "[data-ops-field='item3_amount']", text: "1000" }
  - { action: fill, selector: "[data-ops-field='customer_price_usd']", text: "20000" }
  - { action: fill, selector: "[data-ops-field='disclosure_operator']", text: "Vietstar Airlines", pauseAfter: 1000 }
  - { action: stub, url: "**/api/ops", from: avex/fixtures/ops-quote_draft.json }
  - { action: click, selector: "[data-act='ops-quote']", pauseAfter: 2400 }

  - { action: scene, label: send, caption: "The margin is visible before it goes out." }
  - { action: wait, ms: 1800 }
  - { action: stub, url: "**/api/ops", from: avex/fixtures/ops-quote_sent.json }
  - { action: click, selector: "[data-act='ops-send']", pauseAfter: 2400 }

  # acceptance
  - { action: scene, label: accept, caption: "The customer says yes, and it is recorded with proof." }
  - { action: fill, selector: "[data-ops-field='accepted_by']", text: "Nguyen Minh Anh", pauseAfter: 800 }
  - { action: stub, url: "**/api/ops", from: avex/fixtures/ops-accepted.json }
  - { action: click, selector: "[data-act='ops-accept']", pauseAfter: 2400 }

  # ── 5. hold the aircraft ────────────────────────────────────────────────
  - { action: stub, url: "**/api/ops", from: avex/fixtures/ops-reserve_pending.json }
  - { action: click, selector: "[data-act='ops-reserve']", pauseAfter: 2200 }
  - { action: stub, url: "**/api/operator-desk*", from: avex/fixtures/desk-reserve.json }
  - { action: stub, url: "**/api/operator-desk*", method: POST, from: avex/fixtures/reserve-approved.json }
  - { action: navigate, url: "http://localhost:3200/operator#/" }
  - { action: waitFor, selector: "[data-op-scope]", timeout: 20000 }
  - { action: scene, label: reserve, caption: "The operator is asked to hold the aircraft." }
  - { action: wait, ms: 2400 }
  - { action: click, selector: "[data-act='op-reserve-yes']", pauseAfter: 2400 }

  # ── 6. money, manifest, confirmation ────────────────────────────────────
  - { action: stub, url: "**/api/requests*", method: GET, from: avex/fixtures/requests-held.json }
  - { action: navigate, url: "http://localhost:3200/operations#/live/AVX-0912-4821" }
  - { action: waitFor, selector: "[data-ops-scope]", timeout: 20000 }
  - { action: scene, label: invoice, caption: "Invoice the customer." }
  - { action: wait, ms: 1600 }
  - { action: stub, url: "**/api/ops", from: avex/fixtures/ops-invoiced.json }
  - { action: click, selector: "[data-act='ops-invoice']", pauseAfter: 2200 }

  - { action: scene, label: payment, caption: "Payment is verified before anything is promised." }
  - { action: scroll, to: "[data-ops-field='payment_reference']", align: center, pauseAfter: 500 }
  - { action: fill, selector: "[data-ops-field='payment_reference']", text: "FT26091200419", pauseAfter: 900 }
  - { action: stub, url: "**/api/ops", from: avex/fixtures/ops-paid.json }
  - { action: click, selector: "[data-act='ops-payment']", pauseAfter: 2400 }

  - { action: scene, label: manifest, caption: "Passenger manifest released to the operator." }
  - { action: scroll, to: "[data-ops-field='pax1_name']", align: center, pauseAfter: 500 }
  - { action: fill, selector: "[data-ops-field='pax1_name']", text: "Nguyen Minh Anh" }
  - { action: fill, selector: "[data-ops-field='pax1_passport']", text: "C1234567", pauseAfter: 800 }
  - { action: stub, url: "**/api/ops", from: avex/fixtures/ops-manifest.json }
  - { action: click, selector: "[data-act='ops-manifest']", pauseAfter: 2400 }

  - { action: scene, label: confirm-operator, caption: "Only now can the operator be confirmed." }
  - { action: scroll, to: "[data-ops-field='operator_reference']", align: center, pauseAfter: 500 }
  - { action: fill, selector: "[data-ops-field='operator_reference']", text: "VSA-9932" }
  - { action: fill, selector: "[data-ops-field='tail_number']", text: "VN-A123" }
  - { action: click, selector: "[data-ops-check='slot_blocked']", pauseAfter: 900 }
  - { action: stub, url: "**/api/ops", from: avex/fixtures/ops-confirmed.json }
  - { action: click, selector: "[data-act='ops-confirm-operator']", pauseAfter: 2600 }

  # ── 7. what the customer sees ───────────────────────────────────────────
  - { action: stub, url: "**/api/track", from: avex/fixtures/track-confirmed.json }
  - { action: navigate, url: "http://localhost:3200/#/track" }
  - { action: waitFor, selector: "#trackRef", timeout: 20000 }
  - { action: scene, label: track, caption: "The customer checks their trip." }
  - { action: fill, selector: "#trackRef", text: "AVX-0912-4821" }
  - { action: fill, selector: "#trackEmail", text: "minh.anh@example.com", pauseAfter: 700 }
  - { action: click, selector: "[data-act='track-go']" }
  - { action: waitFor, selector: ".tl", timeout: 20000 }
  - { action: scene, label: done, caption: "Confirmed — aircraft, price, times, pick-up." }
  - { action: wait, ms: 2000 }
  - { action: scroll, to: ".tl", align: top, pauseAfter: 2600 }

outputs:
  mp4: true
  gif: false
  thumbnail: { scene: queue }
