{
  "name": "retake-demos",
  "version": "0.12.0",
  "description": "Demo-as-code for coding agents: a YAML manifest in, a product walkthrough video out. Rerun the demo instead of re-recording it.",
  "keywords": [
    "demo",
    "screen-recording",
    "playwright",
    "mcp",
    "claude-code",
    "codex",
    "video",
    "documentation",
    "agent"
  ],
  "homepage": "https://github.com/glebbogachev00/retake#readme",
  "bugs": {
    "url": "https://github.com/glebbogachev00/retake/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/glebbogachev00/retake.git"
  },
  "license": "MIT",
  "author": "Gleb Bogachev",
  "type": "module",
  "bin": {
    "retake": "dist/cli.js"
  },
  "files": [
    "dist",
    "skill",
    "assets/logo.svg",
    "assets/icon-192.png",
    "assets/icon-512.png",
    "demos/example.yaml",
    ".env.example",
    "README.md",
    "LICENSE",
    "scripts/patch-testreel.mjs",
    "AGENTS.md",
    "llms.txt",
    "site/releases.json"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json && mkdir -p dist/ui && cp src/ui/*.html dist/ui/ && chmod +x dist/cli.js",
    "postinstall": "node scripts/patch-testreel.mjs",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "retake": "tsx src/cli.ts",
    "ui": "tsx src/cli.ts ui",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "commander": "^14.0.3",
    "playwright": "^1.58.2",
    "testreel": "0.2.0",
    "yaml": "^2.8.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=20"
  }
}
