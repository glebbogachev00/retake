# Retake — optional. Only `retake describe` and `retake ideas` use a model; validate/dry/run/render/check never do.
# With a coding agent driving Retake over MCP you can leave all of this empty.
# Pick explicitly with RETAKE_MODEL=claude-code|codex|groq|mistral|local; otherwise the first available is used.
RETAKE_MODEL=claude-code

# A. the CLIs you are already signed into on this machine — no keys needed
#    claude-code: `claude` (Claude Code)      codex: `codex` (OpenAI Codex CLI)
#    optional: RETAKE_CLAUDE_MODEL=  RETAKE_CODEX_MODEL=

# A. hosted keys
GROQ_API_KEY=
RETAKE_GROQ_MODEL=openai/gpt-oss-120b
MISTRAL_API_KEY=
RETAKE_MISTRAL_MODEL=mistral-small-latest

# B. local, OpenAI-compatible (Ollama: http://localhost:11434/v1 · LM Studio: http://localhost:1234/v1)
RETAKE_LOCAL_URL=
RETAKE_LOCAL_MODEL=llama3.1
RETAKE_LOCAL_KEY=local
